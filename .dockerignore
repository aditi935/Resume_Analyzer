# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Environment & secrets (never bake into the image) ─────────────────────────
.env
*.env
.env.*

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Uploaded files / temp data ────────────────────────────────────────────────
uploads/
*.pdf
*.docx

# ── Docker files themselves ───────────────────────────────────────────────────
Dockerfile
docker-compose.yml

# ── Docs & README ─────────────────────────────────────────────────────────────
README.md
docs/